

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Instrumentos Cadastrados</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1>Instrumentos Cadastrados</h1>

    <% if (instrumentos.length > 0) { %>

        <table border="1">

            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Fabricante</th>
                    <th>Preço</th>
                    <th>Tipo</th>
                </tr>
            </thead>

            <tbody>

                <% instrumentos.forEach(function(instrumento) { %>

                    <tr>

                        <td>
                            <%= instrumento.nome || 'Não informado' %>
                        </td>

                        <td>
                            <%= instrumento.fabricante || 'Não informado' %>
                        </td>

                        <td>
                            <%= instrumento.preco != null
                                ? Number(instrumento.preco).toLocaleString('pt-BR', {
                                    style: 'currency',
                                    currency: 'BRL'
                                })
                                : 'Não informado' %>
                        </td>

                        <td>
                            <%= instrumento.tipo || 'Não informado' %>
                        </td>

                    </tr>

                <% }); %>

            </tbody>

        </table>

    <% } else { %>

        <p>Nenhum instrumento cadastrado até o momento.</p>

    <% } %>

    <p>
        <a href="/instrumento/add">Cadastrar novo instrumento</a>
    </p>

</body>

</html>
